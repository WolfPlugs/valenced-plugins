		"gifenc": "^1.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"react-native": "0.81.6",
		"typescript": "^7.0.2",
		"@react-native-community/netinfo": "^12.0.1"
